{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "dev:local": "NODE_ENV=development ./scripts/run-local-node.sh --env-file=.env --import tsx server/index.ts",
    "build": "tsx script/build.ts",
    "start": "npm run migrate && NODE_ENV=production node dist/index.cjs",
    "start:local": "npm run migrate:local && NODE_ENV=production ./scripts/run-local-node.sh --env-file=.env dist/index.cjs",
    "migrate": "node dist/migrate.cjs",
    "migrate:local": "./scripts/run-local-node.sh --env-file=.env dist/migrate.cjs",
    "sync:all": "npm run migrate && node dist/sync-all.cjs",
    "sync:all:local": "npm run migrate:local && ./scripts/run-local-node.sh --env-file=.env dist/sync-all.cjs",
    "check": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "db:push": "drizzle-kit push",
    "db:push:local": "./scripts/run-local-node.sh --env-file=.env ./node_modules/drizzle-kit/bin.cjs push"
  },
  "dependencies": {
